---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PrNotice from '../../components/PrNotice.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(post.data.title)}&url=${encodeURIComponent(`https://manabihikaku.com/posts/${post.id}/`)}`;
const toc = headings.filter((h) => h.depth === 2);
const related = (await getCollection('posts', ({ data }) => !data.draft))
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    entry: p,
    shared: p.data.tags.filter((t) => post.data.tags.includes(t)).length,
  }))
  .filter((x) => x.shared > 0)
  .sort(
    (a, b) =>
      b.shared - a.shared ||
      b.entry.data.pubDate.valueOf() - a.entry.data.pubDate.valueOf(),
  )
  .slice(0, 3)
  .map((x) => x.entry);
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  breadcrumb={post.data.title}
>
  <article>
    <nav class="breadcrumb"><a href="/">ホーム</a> ＞ {post.data.title}</nav>
    <div class="post-head">
      {
        post.data.tags.length > 0 && (
          <ul class="tag-list">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
      <h1>{post.data.title}</h1>
      <p class="post-date">
        公開：{post.data.pubDate.toLocaleDateString('ja-JP')}
        {
          post.data.updatedDate && (
            <>／更新：{post.data.updatedDate.toLocaleDateString('ja-JP')}</>
          )
        }
      </p>
    </div>
    <PrNotice />
    {
      toc.length >= 3 && (
        <nav class="toc">
          <p class="toc-title">この記事の目次</p>
          <ol>
            {toc.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    <Content />
    <PrNotice variant="full" />
    <div class="editor-box">
      <p class="editor-name">この記事について｜マナビ比較 編集部</p>
      <p>
        各社の公式サイトなど、公開されている情報を確認して作成しています。料金や条件は変更される場合がありますので、申し込み前に公式サイトでご確認ください。<a href="/about/">運営者情報はこちら</a>
      </p>
    </div>
    <div class="share-row">
      <a class="share-x" href={shareUrl} target="_blank" rel="noopener">Xでシェアする</a>
    </div>
    {
      related.length > 0 && (
        <section class="related">
          <h2>関連記事</h2>
          <ul class="post-list">
            {related.map((p) => (
              <li class="post-card">
                {p.data.tags.length > 0 && (
                  <ul class="tag-list">
                    {p.data.tags.slice(0, 3).map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                )}
                <a class="post-title" href={`/posts/${p.id}/`}>
                  {p.data.title}
                </a>
                <div class="post-meta">
                  {p.data.pubDate.toLocaleDateString('ja-JP')}｜{p.data.description}
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <a class="back-link" href="/">← 記事一覧へ戻る</a>
  </article>
</Base>
