---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base title="資格・オンライン学習の比較">
  <h1>資格・オンライン学習を、料金と条件で比べる</h1>
  <p>
    マナビ比較は、資格のサブスク・通信講座、オンライン英会話、スキルスクールを、
    料金・縛り期間・解約条件などの「申し込む前に知りたい条件」で比較するサイトです。
  </p>

  <h2>記事一覧</h2>
  {
    posts.length === 0 ? (
      <p>記事は準備中です。</p>
    ) : (
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            <br />
            <small>{post.data.pubDate.toLocaleDateString('ja-JP')}｜{post.data.description}</small>
          </li>
        ))}
      </ul>
    )
  }
</Base>
