---
interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  breadcrumb?: string;
}
const {
  title,
  description = '資格・オンライン学習・スキル講座を、料金と条件で比べる比較サイトです。',
  type = 'website',
  pubDate,
  updatedDate,
  breadcrumb,
} = Astro.props;
const siteUrl = 'https://manabihikaku.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullTitle = `${title} | マナビ比較`;
const ogImage = `${siteUrl}/og-image.png`;
const jsonLd =
  type === 'article' && pubDate
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        datePublished: pubDate.toISOString(),
        ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
        mainEntityOfPage: canonical,
        author: { '@type': 'Organization', name: 'マナビ比較 編集部' },
        publisher: { '@type': 'Organization', name: 'マナビ比較' },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'マナビ比較',
        url: siteUrl,
        description,
      };
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | マナビ比較</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="マナビ比較" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      breadcrumb && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${siteUrl}/` },
              { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
            ],
          })}
        />
      )
    }
    <meta name="google-site-verification" content="ltmc_DpECrXJkO2hXpTIl2Rk0SOUjcxMgZIJGFU08x4" />
  </head>
  <body>
    <div class="bg-decoration" aria-hidden="true">
      <svg class="bg-wave" viewBox="0 0 1440 210" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,120 C240,60 420,170 720,140 C1020,110 1200,50 1440,100 L1440,210 L0,210 Z" fill="rgba(63,179,169,0.13)"></path>
        <path d="M0,160 C260,110 480,190 760,170 C1040,150 1240,110 1440,150 L1440,210 L0,210 Z" fill="rgba(14,131,136,0.12)"></path>
      </svg>
    </div>
    <header class="site-header">
      <div class="header-inner">
        <a class="logo" href="/"><span class="logo-mark">比</span>マナビ比較</a>
        <nav>
          <a href="/">記事一覧</a>
          <a href="/about/">運営者情報</a>
          <a href="/privacy/">プライバシーポリシー</a>
        </nav>
      </div>
    </header>
    <main class="page-card">
      <slot />
    </main>
    <footer class="site-footer">
      <p class="footer-logo">マナビ比較</p>
      <p>当サイトの記事にはプロモーション（広告）が含まれます。料金・条件は各公式サイトでご確認ください。</p>
      <p>&copy; 2026 マナビ比較</p>
    </footer>
    <style is:global>
      :root {
        color-scheme: light;
        --bg: #eef7f7;
        --card: #ffffff;
        --ink: #223636;
        --muted: #687d7d;
        --accent: #0e8388;
        --accent-dark: #0a6468;
        --accent-light: #3fb3a9;
        --accent-soft: #e8f4f4;
        --accent-softer: #f3fafa;
        --line: #ddefef;
        --grad: linear-gradient(120deg, #0e8388 0%, #2aa79b 55%, #56c2b4 100%);
      }
      * {
        box-sizing: border-box;
      }
      body {
        font-family: 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', 'Noto Sans JP', sans-serif;
        font-size: 17px;
        line-height: 1.9;
        letter-spacing: 0.02em;
        color: var(--ink);
        background-color: var(--bg);
        background-image:
          radial-gradient(circle at 8% 10%, rgba(86, 194, 180, 0.22) 0, transparent 320px),
          radial-gradient(circle at 93% 6%, rgba(96, 178, 232, 0.14) 0, transparent 340px),
          radial-gradient(circle at 88% 74%, rgba(14, 131, 136, 0.15) 0, transparent 360px),
          radial-gradient(circle at 10% 86%, rgba(127, 209, 200, 0.18) 0, transparent 320px),
          radial-gradient(rgba(14, 131, 136, 0.08) 1.2px, transparent 1.35px);
        background-size: auto, auto, auto, auto, 22px 22px;
        background-attachment: fixed;
        margin: 0;
        padding: 0 1rem 3rem;
      }
      /* 背景の装飾（下部の波） */
      .bg-decoration {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 0;
        pointer-events: none;
      }
      .bg-wave {
        display: block;
        width: 100%;
        height: 210px;
      }
      .site-header,
      .page-card,
      .site-footer {
        position: relative;
        z-index: 1;
      }
      /* ヘッダー */
      .site-header {
        background: rgba(255, 255, 255, 0.92);
        margin: 0 -1rem 1.6rem;
        padding: 0 1rem;
        border-bottom: 3px solid transparent;
        border-image: var(--grad) 1;
        box-shadow: 0 1px 10px rgba(14, 131, 136, 0.07);
      }
      .header-inner {
        max-width: 800px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.85rem 0;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .logo {
        font-weight: 800;
        font-size: 1.28rem;
        color: var(--ink);
        text-decoration: none;
        letter-spacing: 0.05em;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
      }
      .logo-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 9px;
        background: var(--grad);
        color: #fff;
        font-size: 1.05rem;
        font-weight: 800;
        box-shadow: 0 3px 8px rgba(14, 131, 136, 0.35);
      }
      nav a {
        margin-left: 1.1rem;
        color: var(--ink);
        text-decoration: none;
        font-size: 0.92rem;
        font-weight: 600;
      }
      nav a:hover {
        color: var(--accent);
        text-decoration: underline;
        text-underline-offset: 4px;
      }
      /* 本文カード */
      .page-card {
        max-width: 800px;
        margin: 0 auto;
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: 18px;
        padding: 2.1rem 2.3rem 2.5rem;
        box-shadow: 0 6px 24px rgba(14, 131, 136, 0.09);
      }
      @media (max-width: 640px) {
        body {
          font-size: 16px;
          padding: 0 0.6rem 2rem;
        }
        .site-header {
          margin: 0 -0.6rem 1.1rem;
          padding: 0 0.6rem;
        }
        .page-card {
          padding: 1.5rem 1.15rem 1.9rem;
          border-radius: 14px;
        }
      }
      /* ヒーロー（トップページ） */
      .hero {
        position: relative;
        overflow: hidden;
        background: var(--grad);
        color: #fff;
        border-radius: 14px;
        padding: 2rem 1.8rem 1.8rem;
        margin-bottom: 2rem;
      }
      .hero::before,
      .hero::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.14);
      }
      .hero::before {
        width: 190px;
        height: 190px;
        right: -50px;
        top: -70px;
      }
      .hero::after {
        width: 110px;
        height: 110px;
        right: 90px;
        bottom: -55px;
        background: rgba(255, 255, 255, 0.1);
      }
      .hero h1 {
        color: #fff;
        font-size: 1.65rem;
        line-height: 1.55;
        margin: 0 0 0.8rem;
        position: relative;
        z-index: 1;
      }
      .hero p {
        margin: 0 0 1.2rem;
        font-size: 0.98rem;
        line-height: 1.85;
        position: relative;
        z-index: 1;
      }
      .hero-points {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0;
        margin: 0;
        position: relative;
        z-index: 1;
      }
      .hero-points li {
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.45);
        border-radius: 999px;
        padding: 0.15rem 0.85rem;
        font-size: 0.85rem;
        font-weight: 700;
        margin: 0;
      }
      /* 見出し・本文 */
      h1 {
        font-size: 1.55rem;
        line-height: 1.55;
        margin: 0.4rem 0 1.2rem;
      }
      h2 {
        font-size: 1.22rem;
        line-height: 1.6;
        margin: 2.3rem 0 1rem;
        padding: 0.5rem 0.95rem;
        background: linear-gradient(90deg, var(--accent-soft), var(--accent-softer));
        border-left: 5px solid var(--accent);
        border-radius: 0 9px 9px 0;
      }
      h3 {
        font-size: 1.08rem;
        margin: 1.9rem 0 0.6rem;
        color: var(--accent-dark);
        padding-bottom: 0.25rem;
        border-bottom: 2px dotted var(--line);
      }
      p {
        margin: 0 0 1.1rem;
      }
      ul,
      ol {
        margin: 0 0 1.2rem;
        padding-left: 1.4rem;
      }
      li {
        margin-bottom: 0.35rem;
      }
      /* 表 */
      table {
        border-collapse: collapse;
        width: 100%;
        margin: 0 0 1.3rem;
        font-size: 0.95rem;
        display: block;
        overflow-x: auto;
      }
      th,
      td {
        border: 1px solid var(--line);
        padding: 0.55rem 0.8rem;
        text-align: left;
        vertical-align: top;
      }
      th {
        background: var(--accent-soft);
        color: var(--accent-dark);
        white-space: nowrap;
      }
      tbody tr:nth-child(even) td {
        background: var(--accent-softer);
      }
      td:first-child {
        font-weight: 700;
      }
      /* 目次 */
      .toc {
        background: var(--accent-softer);
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 1rem 1.3rem 0.6rem;
        margin: 0 0 1.6rem;
      }
      .toc-title {
        font-weight: 700;
        color: var(--accent-dark);
        margin: 0 0 0.5rem;
      }
      .toc ol {
        margin: 0 0 0.6rem;
        padding-left: 1.3rem;
      }
      .toc li {
        margin-bottom: 0.3rem;
      }
      /* 公式サイトへのボタン（アフィリエイトリンク） */
      article a[href*='px.a8.net']:not(:has(img)) {
        display: block;
        text-align: center;
        background: linear-gradient(90deg, var(--accent), var(--accent-light));
        color: #fff;
        font-weight: 700;
        font-size: 1.02rem;
        padding: 0.95rem 1.2rem;
        border-radius: 999px;
        margin: 1.2rem 0 1.6rem;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(14, 131, 136, 0.28);
      }
      article a[href*='px.a8.net']:not(:has(img)):hover {
        color: #fff;
        opacity: 0.92;
      }
      /* 関連記事 */
      .related {
        margin-top: 2.6rem;
      }
      /* パンくず */
      .breadcrumb {
        font-size: 0.8rem;
        color: var(--muted);
        margin: 0 0 1rem;
      }
      .breadcrumb a {
        color: var(--muted);
        font-weight: 400;
      }
      /* 編集部ボックス・シェア */
      .editor-box {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 1rem 1.2rem;
        margin: 2.2rem 0 0;
        font-size: 0.9rem;
      }
      .editor-box .editor-name {
        font-weight: 700;
        color: var(--accent-dark);
        margin: 0 0 0.3rem;
      }
      .editor-box p {
        margin: 0;
      }
      .share-row {
        margin: 1.4rem 0 0;
      }
      .share-x {
        display: inline-block;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.45rem 1.1rem;
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--ink);
        background: #fff;
        text-decoration: none;
      }
      .share-x:hover {
        color: var(--ink);
        border-color: var(--accent);
      }
      a {
        color: var(--accent);
      }
      a:hover {
        color: var(--accent-dark);
      }
      strong {
        color: var(--accent-dark);
      }
      blockquote {
        margin: 0 0 1.3rem;
        padding: 0.9rem 1.2rem;
        background: var(--accent-softer);
        border-left: 4px solid var(--accent-light);
        border-radius: 0 10px 10px 0;
        font-size: 0.97rem;
      }
      blockquote p {
        margin: 0;
      }
      small {
        color: var(--muted);
      }
      /* 記事ヘッダー */
      .post-head {
        border-bottom: 2px solid var(--accent-soft);
        padding-bottom: 1.1rem;
        margin-bottom: 1.4rem;
      }
      .post-head h1 {
        margin: 0.5rem 0 0.6rem;
      }
      .tag-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .tag-list li {
        background: var(--accent-soft);
        color: var(--accent-dark);
        border-radius: 999px;
        padding: 0.05rem 0.75rem;
        font-size: 0.8rem;
        font-weight: 700;
        margin: 0;
      }
      .post-date {
        font-size: 0.85rem;
        color: var(--muted);
      }
      .back-link {
        display: inline-block;
        margin-top: 2.2rem;
        padding: 0.55rem 1.4rem;
        border: 2px solid var(--accent);
        border-radius: 999px;
        color: var(--accent-dark);
        font-weight: 700;
        font-size: 0.92rem;
        text-decoration: none;
      }
      .back-link:hover {
        background: var(--grad);
        color: #fff;
        border-color: transparent;
      }
      /* フッター */
      .site-footer {
        max-width: 800px;
        margin: 2.2rem auto 0;
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted);
      }
      .site-footer p {
        margin: 0 0 0.3rem;
      }
      .footer-logo {
        font-weight: 800;
        color: var(--accent);
        font-size: 0.95rem;
        letter-spacing: 0.06em;
      }
      /* トップページの記事カード */
      .post-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: 1.1rem;
      }
      .post-card {
        position: relative;
        border: 1px solid var(--line);
        border-radius: 13px;
        padding: 1.15rem 1.35rem 1.05rem;
        background: #fff;
        overflow: hidden;
        transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
      }
      .post-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 5px;
        background: var(--grad);
      }
      .post-card:hover {
        border-color: var(--accent-light);
        box-shadow: 0 8px 20px rgba(14, 131, 136, 0.14);
        transform: translateY(-2px);
      }
      .post-card .post-title {
        font-weight: 800;
        font-size: 1.06rem;
        text-decoration: none;
        color: var(--ink);
        line-height: 1.6;
        display: inline-block;
        margin: 0.25rem 0 0.35rem;
      }
      .post-card .post-title:hover {
        color: var(--accent);
      }
      .post-card .post-meta {
        font-size: 0.86rem;
        color: var(--muted);
        line-height: 1.75;
        margin-bottom: 0.55rem;
      }
      .post-card .tag-list {
        margin-bottom: 0.35rem;
      }
    </style>
  </body>
</html>
